ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Runway Gen-4 Turbo (image-to-video). Get a key from a developer
# organization at dev.runwayml.com (Billing tab needs credits added before
# the API will accept requests). Also set VIDEO_GENERATION_PROVIDER=runway
# below to actually activate this provider — without it, video generation
# stays on the built-in "none" stub and no real API calls are made.
RUNWAYML_API_SECRET=
VIDEO_GENERATION_PROVIDER=
# Required in production (e.g. Vercel) for job data — including a completed
# script — to survive across separate serverless invocations. Without these,
# job state only lives in one instance's memory and can be lost the moment a
# different instance or a cold start handles the next request. Provision a
# Redis database (e.g. via the Vercel Marketplace, or any Upstash-compatible
# provider) and set its REST URL/token here. Not required for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PORT=
